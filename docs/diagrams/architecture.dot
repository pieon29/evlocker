digraph G {
  graph [rankdir=TB, fontname="NanumGothic", fontsize=13, nodesep=0.5, ranksep=0.7, labelloc=t, label="그림 1. evlocker 전체 아키텍처 (Solid Cloud Shared Network, VM 5대)", bgcolor="white", pad=0.3];
  node [fontname="NanumGothic", fontsize=11, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge [fontname="NanumGothic", fontsize=9, color="#555555"];

  user [label="사용자 / 운영자\n(OpenVPN 접속)", shape=box, fillcolor="#eef2f7"];

  subgraph cluster_net {
    label="Shared Network (단일 L2, 분리는 호스트 방화벽 /32 규칙으로 구현)"; style="rounded,dashed"; color="#888888"; fontsize=11;

    mon [label="mon01  (단일 진입점)\n─────────────\nHAProxy :443/:80  (TCP, PROXY v2)\nBastion SSH :22\nPrometheus · Grafana · Blackbox\nrsyslog 중앙 로그 (400일)\n암호화 백업 · pg_receivewal", fillcolor="#fff4e0"];

    subgraph cluster_web {
      label="웹 계층  (mon01에서만 접근)"; style="rounded"; color="#4a7bb7";
      web1 [label="web01\nNginx TLS 1.2/1.3 · rate limit\nApp 컨테이너 (read-only, cap-drop ALL)", fillcolor="#e8f0fb"];
      web2 [label="web02\nNginx TLS 1.2/1.3 · rate limit\nApp 컨테이너 (read-only, cap-drop ALL)", fillcolor="#e8f0fb"];
    }

    subgraph cluster_db {
      label="데이터 계층  (웹·mon01·피어만 5432 허용)"; style="rounded"; color="#3c8d5a";
      db1 [label="db01  PostgreSQL 16\n주(primary) · pgaudit\nKeepalived (승격 판단)", fillcolor="#e6f4ea"];
      db2 [label="db02  PostgreSQL 16\n복제본(standby)\nKeepalived (승격 판단)", fillcolor="#e6f4ea"];
    }
  }

  user -> mon [xlabel="HTTPS 443 · SSH 22  "];
  mon -> web1 [label="443 + PROXY v2\n/healthz 2초 검사"];
  mon -> web2;
  web1 -> db1 [label="libpq 멀티호스트\nread-write 자동 탐색"];
  web2 -> db1;
  web1 -> db2 [style=dashed, label="장애 시"];
  web2 -> db2 [style=dashed];
  db1 -> db2 [label="스트리밍 복제", color="#3c8d5a", penwidth=1.6];
  db1 -> mon [style=dashed, color="#b36b00", constraint=false];
  web1 -> mon [style=dotted, color="#888888", constraint=false];
  db2 -> mon [style=dotted, color="#888888", constraint=false];
  db1 -> db2 [label="VRRP 유니캐스트", style=dotted, dir=both, color="#3c8d5a"];

  legend [shape=note, fontsize=10, fillcolor="#f7f7f7", label="범례\l주황 점선: WAL 실시간 수집 + 15분 암호화 덤프 → mon01\l회색 점선: syslog 514 중앙 로그 + Prometheus 지표 수집\l검은 점선: DB 장애 시 앱이 자동으로 db02에 연결\l"];
  db2 -> legend [style=invis];
}
