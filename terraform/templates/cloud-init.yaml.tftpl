#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
chpasswd:
  expire: false
  users:
    - name: ubuntu
      password: ${console_password}
      type: text
ssh_authorized_keys:
  - ${ssh_public_key}
bootcmd:
  - |
    IF=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2; exit}')
    ip link set dev "$IF" mtu ${mtu}
    sysctl -w net.ipv4.tcp_mtu_probing=1
    iptables -t mangle -C POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss ${mtu - 40} 2>/dev/null || iptables -t mangle -A POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss ${mtu - 40}
