#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
bootcmd:
  - |
    IF=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2; exit}')
    cat > /etc/netplan/90-evl-mtu.yaml <<NETPLAN
    network:
      version: 2
      ethernets:
        $IF:
          mtu: ${mtu}
          dhcp4-overrides:
            use-mtu: false
    NETPLAN
    chmod 600 /etc/netplan/90-evl-mtu.yaml
    ip link set dev "$IF" mtu ${mtu}
ssh_pwauth: false
disable_root: true
chpasswd:
  expire: false
  users:
    - name: ubuntu
      password: ${console_password}
      type: text
ssh_authorized_keys:
  - ${ssh_public_key}
write_files:
  - path: /etc/evlocker/node.env
    permissions: '0600'
    owner: root:root
    encoding: b64
    content: ${env_b64}
%{ for f in files ~}
  - path: ${f.path}
    permissions: '${f.mode}'
    owner: root:root
    encoding: b64
    content: ${f.content}
%{ endfor ~}
runcmd:
  - [bash, -c, "netplan apply || true; ip link set dev $(ip -o -4 route show default | awk '{print $5; exit}') mtu ${mtu}; ip -o link show | grep -o 'mtu [0-9]*' | head -2"]
  - [bash, -c, "for i in $(seq 1 30); do git clone ${repo_url} /opt/evlocker && break; sleep 10; done; git -C /opt/evlocker checkout ${repo_ref} && bash /opt/evlocker/bootstrap/run.sh >> /var/log/evlocker-bootstrap.log 2>&1"]
