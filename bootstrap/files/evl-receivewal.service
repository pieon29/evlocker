[Unit]
Description=evlocker continuous WAL archive
After=network-online.target

[Service]
EnvironmentFile=/etc/evlocker/node.env
Environment=PGSSLMODE=require
Environment=HOME=/root
ExecStart=/bin/sh -c 'exec pg_receivewal -h "$DB_VIP" -U evl_backup -D /srv/backup/wal --no-loop'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
