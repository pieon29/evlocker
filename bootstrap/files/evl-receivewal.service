[Unit]
Description=evlocker continuous WAL archive
After=network-online.target

[Service]
EnvironmentFile=/etc/evlocker/node.env
Environment=PGSSLMODE=require
Environment=HOME=/root
ExecStart=/bin/sh -c 'exec pg_receivewal -d "host=$DB1_IP,$DB2_IP user=evl_backup target_session_attrs=read-write connect_timeout=5" -D /srv/backup/wal --no-loop'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
