#!/usr/bin/env bash
set -euo pipefail
set -a
. /etc/evlocker/node.env
set +a

TS="$(date -u +%Y%m%dT%H%M%SZ)"
DEST="/srv/backup/base/${TS}"
PGSSLMODE=require pg_basebackup -d "host=${DB1_IP},${DB2_IP} user=evl_backup target_session_attrs=read-write connect_timeout=5" -D "${DEST}" -Ft -z -X fetch
ls -1dt /srv/backup/base/*/ | tail -n +4 | xargs -r rm -rf
logger -t evl-backup "basebackup ok dir=${DEST}"
